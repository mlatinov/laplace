//@laplace
//@brief Random-walk Metropolis with a diagonal metric
//@param eps Step size (adapted toward 0.234 acceptance)
//@param m Diagonal inverse metric (adapted in warmup)
//
// The .lapkernel twin of the built-in `rwm` (src/kernels/rwm.rs): same
// proposal, same arithmetic order, same random numbers in the same order
// (dim normal draws, then propose()'s one uniform), so with the same seed
// the two produce the same draws (Phase 2.5 equivalence tests).
kernel rwm {
  tuning {
    real<lower=0> eps = 1 @adapt(step_size, target_accept = 0.234);
    vector<lower=0>[dim] m = rep_vector(1, dim) @adapt(metric);
  }
  step {
    vector[dim] q_new = q + eps * sqrt(m) .* std_normal_rng(dim);
    propose(q_new, 0);
  }
}
